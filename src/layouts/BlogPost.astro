---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = Omit<CollectionEntry<'blog'>['data'], 'pubDate'> & { pubDate?: Date };

const { title, description, pubDate, updatedDate, heroImage, feishu } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			article={pubDate && { published: pubDate, modified: updatedDate }}
		/>
	</head>

	<body>
		<Header />
		<main class="post">
			<article>
				{heroImage && <img class="hero-image" width={1020} height={510} src={heroImage} alt="" />}
				<header class="post-header">
					<h1>{title}</h1>
					{pubDate && <p class="lead">{description}</p>}
					{
						feishu && (
							<a class="cta" href={feishu} target="_blank" rel="noopener">
								在飞书阅读全文 →
							</a>
						)
					}
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
