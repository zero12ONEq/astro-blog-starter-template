---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION } from '../consts';
import { getPosts } from '../posts';

const posts = await getPosts();
const notes = posts.filter((post) => post.data.feishu);
const prep = posts.filter((post) => !post.data.feishu);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title="张梓阳" description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class="intro">
        <h1>hi, i'm zero</h1>
        <p class="lead">
          我是张梓阳，一名正在学单片机和嵌入式的学生。这里放我的蓝桥杯备赛记录、C 语言笔记，还有一些真正用得上的工程。
        </p>
        <p class="motto">把难的问题拆开，再一块块装回去。</p>
      </section>

      <section class="block">
        <h2>学习笔记</h2>
        <PostList posts={notes} />
      </section>

      <section class="block">
        <h2>备赛</h2>
        <PostList posts={prep} />
      </section>
    </main>
    <Footer />
  </body>
</html>
