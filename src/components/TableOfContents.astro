---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}

const items = Astro.props.headings.filter((heading) => heading.depth <= 3);
---

{
	items.length >= 10 && (
		<>
			<details class="toc">
				<summary>目录（{items.length}）</summary>
				<ul>
					{items.map((heading) => (
						<li class={`depth-${heading.depth}`}>
							<a href={`#${heading.slug}`}>{heading.text}</a>
						</li>
					))}
				</ul>
			</details>
			<a class="to-top" href="#top" aria-label="回到顶部">↑</a>
		</>
	)
}
